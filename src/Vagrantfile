Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.box_check_update = false
  config.vm.synced_folder ".", "/home/vagrant/src"
  config.vm.provision "shell", path: "scripts/install_docker.sh"

  config.vm.define "manager01" do |manager|
    manager.vm.provision "shell", path: "scripts/manager.sh"
    manager.vm.hostname = "manager01"
    manager.vm.network "private_network", ip: "192.168.56.10"
    manager.vm.provider "virtualbox" do |vb|
      vb.memory = "4096"
      vb.cpus = 4
      vb.name = "manager01"
    end
  end

  config.vm.define "worker01" do |worker01|
    worker01.vm.hostname = "worker01"
    worker01.vm.network "private_network", ip: "192.168.56.11"
    worker01.vm.provision "shell", path: "scripts/worker.sh"
    worker01.vm.provider "virtualbox" do |vb|
      vb.memory = "1024"
      vb.cpus = 2
      vb.name = "worker01"
    end
  end

  config.vm.define "worker02" do |worker02|
    worker02.vm.hostname = "worker02"
    worker02.vm.network "private_network", ip: "192.168.56.12"
    worker02.vm.provision "shell", path: "scripts/worker.sh"
    worker02.vm.provider "virtualbox" do |vb|
      vb.memory = "1024"
      vb.cpus = 2
      vb.name = "worker2"
    end
  end
end